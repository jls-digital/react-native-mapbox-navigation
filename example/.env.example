# Copy this file to `.env` (gitignored) and fill in your public Mapbox token.
# See the top-level README.md "Mapbox tokens" section for the full setup.

# Public runtime token (pk.*) — consumed by the app at runtime.
# Injected into Info.plist (MBXAccessToken) and res/values/mapbox_access_token.xml
# during `expo prebuild`.
MAPBOX_ACCESS_TOKEN=pk.replace_me
